@ThuyetMinhDaNgonNgu_HostAddress = https://localhost:7138

### Lấy danh sách địa điểm
GET {{ThuyetMinhDaNgonNgu_HostAddress}}/api/locations
Accept: application/json

### Lấy thông tin địa điểm có mã 1
GET {{ThuyetMinhDaNgonNgu_HostAddress}}/api/locations/1
Accept: application/json

### Lấy danh sách ngôn ngữ
GET {{ThuyetMinhDaNgonNgu_HostAddress}}/api/languages
Accept: application/json

### Thêm ngôn ngữ tiếng Tây Ban Nha, sau đó gọi GET để kiểm tra
POST {{ThuyetMinhDaNgonNgu_HostAddress}}/api/languages
Content-Type: application/json

{
  "code": "es",
  "name": "Español"
}

### Tạo thuyết minh mô phỏng bằng tiếng Anh
POST {{ThuyetMinhDaNgonNgu_HostAddress}}/api/narrations
Content-Type: application/json

{
  "locationId": 1,
  "languageCode": "en"
}

### Kiểm tra lỗi: địa điểm không tồn tại (dự kiến 404)
POST {{ThuyetMinhDaNgonNgu_HostAddress}}/api/narrations
Content-Type: application/json

{
  "locationId": 999,
  "languageCode": "en"
}

### Kiểm tra lỗi: ngôn ngữ chưa hỗ trợ (dự kiến 400)
POST {{ThuyetMinhDaNgonNgu_HostAddress}}/api/narrations
Content-Type: application/json

{
  "locationId": 1,
  "languageCode": "fr"
}

### Đăng nhập Admin để lấy JWT cho các request quản trị
# @name adminLogin
POST {{ThuyetMinhDaNgonNgu_HostAddress}}/api/admin/auth/login
Content-Type: application/json

{
  "username": "<admin-username>",
  "password": "<admin-password>"
}

### Tạo địa điểm (Admin)
POST {{ThuyetMinhDaNgonNgu_HostAddress}}/api/locations
Authorization: Bearer {{adminLogin.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Địa điểm kiểm thử",
  "city": "Hà Nội",
  "description": "Dữ liệu kiểm thử local.",
  "latitude": 21.0285,
  "longitude": 105.8542
}

### Cập nhật địa điểm (Admin)
PUT {{ThuyetMinhDaNgonNgu_HostAddress}}/api/locations/999999
Authorization: Bearer {{adminLogin.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Địa điểm đã cập nhật",
  "city": "Hà Nội",
  "description": "Mô tả đã cập nhật.",
  "latitude": 21.0285,
  "longitude": 105.8542
}

### Xóa địa điểm (Admin; dùng ID dữ liệu kiểm thử local)
DELETE {{ThuyetMinhDaNgonNgu_HostAddress}}/api/locations/999999
Authorization: Bearer {{adminLogin.response.body.accessToken}}

### Tạo ngôn ngữ (Admin)
POST {{ThuyetMinhDaNgonNgu_HostAddress}}/api/languages
Authorization: Bearer {{adminLogin.response.body.accessToken}}
Content-Type: application/json

{
  "code": "es",
  "name": "Español"
}

### Cập nhật tên ngôn ngữ (Admin)
PUT {{ThuyetMinhDaNgonNgu_HostAddress}}/api/languages/es
Authorization: Bearer {{adminLogin.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Tiếng Tây Ban Nha"
}

### Xóa ngôn ngữ (Admin; bị từ chối nếu đang được tham chiếu)
DELETE {{ThuyetMinhDaNgonNgu_HostAddress}}/api/languages/es
Authorization: Bearer {{adminLogin.response.body.accessToken}}

### Xóa bài thuyết minh và audio không còn được tham chiếu (Admin)
DELETE {{ThuyetMinhDaNgonNgu_HostAddress}}/api/admin/narrations/999999/es
Authorization: Bearer {{adminLogin.response.body.accessToken}}
